{
  "name": "private-copilot",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "publisher": "private-copilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amar1432/private-copilot.git"
  },
  "description": "Private, Fast, Configurable AI Autocomplete for VS Code",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "benchmark": "pnpm --filter @private-copilot/core test src/evaluation",
    "clean": "pnpm -r clean",
    "package": "pnpm --filter private-copilot package"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
