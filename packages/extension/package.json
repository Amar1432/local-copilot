{
  "name": "private-copilot",
  "displayName": "Private Copilot",
  "description": "Private, Fast, Configurable AI Autocomplete for VS Code",
  "version": "0.1.5",
  "publisher": "private-copilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amar1432/private-copilot.git"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "ai",
    "autocomplete",
    "copilot",
    "code-completion",
    "local",
    "privacy"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:sql",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onCommand:privateCopilot.enable",
    "onCommand:privateCopilot.disable",
    "onCommand:privateCopilot.triggerCompletion",
    "onCommand:privateCopilot.selectModel",
    "onCommand:privateCopilot.selectProvider",
    "onCommand:privateCopilot.testConnection",
    "onCommand:privateCopilot.showDiagnostics",
    "onCommand:privateCopilot.clearCache",
    "onCommand:privateCopilot.openSettings",
    "onCommand:privateCopilot.setApiKey",
    "onCommand:privateCopilot.deleteApiKey",
    "onCommand:privateCopilot.statusBarMenu",
    "onCommand:privateCopilot.viewMetrics",
    "onCommand:privateCopilot.resetMetrics",
    "onCommand:privateCopilot.toggle",
    "onCommand:privateCopilot.quickSettings",
    "onCommand:privateCopilot.setupWizard",
    "onCommand:privateCopilot.refreshDiagnostics",
    "onCommand:privateCopilot.exportDiagnostics",
    "onCommand:privateCopilot.exportTelemetry"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "privateCopilot.exportTelemetry",
        "title": "Private Copilot: Export Anonymized Telemetry"
      },
      {
        "command": "privateCopilot.statusBarMenu",
        "title": "Private Copilot: Status Bar Menu"
      },
      {
        "command": "privateCopilot.viewMetrics",
        "title": "Private Copilot: View Completion Metrics"
      },
      {
        "command": "privateCopilot.resetMetrics",
        "title": "Private Copilot: Reset Completion Metrics"
      },
      {
        "command": "privateCopilot.enable",
        "title": "Private Copilot: Enable"
      },
      {
        "command": "privateCopilot.disable",
        "title": "Private Copilot: Disable"
      },
      {
        "command": "privateCopilot.triggerCompletion",
        "title": "Private Copilot: Trigger Completion"
      },
      {
        "command": "privateCopilot.selectModel",
        "title": "Private Copilot: Select Model"
      },
      {
        "command": "privateCopilot.selectProvider",
        "title": "Private Copilot: Select Provider"
      },
      {
        "command": "privateCopilot.testConnection",
        "title": "Private Copilot: Test Connection"
      },
      {
        "command": "privateCopilot.showDiagnostics",
        "title": "Private Copilot: Show Diagnostics"
      },
      {
        "command": "privateCopilot.clearCache",
        "title": "Private Copilot: Clear Cache"
      },
      {
        "command": "privateCopilot.openSettings",
        "title": "Private Copilot: Open Settings"
      },
      {
        "command": "privateCopilot.setApiKey",
        "title": "Private Copilot: Set API Key"
      },
      {
        "command": "privateCopilot.deleteApiKey",
        "title": "Private Copilot: Clear API Key"
      },
      {
        "command": "privateCopilot.toggle",
        "title": "Private Copilot: Toggle Enable/Disable"
      },
      {
        "command": "privateCopilot.quickSettings",
        "title": "Private Copilot: Quick Settings"
      },
      {
        "command": "privateCopilot.setupWizard",
        "title": "Private Copilot: Setup Wizard"
      },
      {
        "command": "privateCopilot.refreshDiagnostics",
        "title": "Private Copilot: Refresh Diagnostics"
      },
      {
        "command": "privateCopilot.exportDiagnostics",
        "title": "Private Copilot: Export Diagnostics to Clipboard"
      }
    ],
    "configuration": {
      "title": "Private Copilot",
      "properties": {
        "privateCopilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the extension"
        },
        "privateCopilot.provider": {
          "type": "string",
          "enum": [
            "custom",
            "ollama",
            "openai",
            "lmstudio",
            "vllm"
          ],
          "default": "custom",
          "description": "Provider type"
        },
        "privateCopilot.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Provider base URL"
        },
        "privateCopilot.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key (stored in SecretStorage)"
        },
        "privateCopilot.model": {
          "type": "string",
          "default": "",
          "description": "Model identifier"
        },
        "privateCopilot.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 1000,
          "description": "Debounce delay in milliseconds"
        },
        "privateCopilot.requestTimeoutMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 10000,
          "description": "Request timeout in milliseconds"
        },
        "privateCopilot.maxOutputTokens": {
          "type": "number",
          "default": 128,
          "minimum": 1,
          "maximum": 1024,
          "description": "Maximum output tokens"
        },
        "privateCopilot.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Sampling temperature"
        },
        "privateCopilot.context.maxLines": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 500,
          "description": "Maximum context lines"
        },
        "privateCopilot.context.budgetPreset": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "rich"
          ],
          "default": "balanced",
          "description": "Context budget preset: fast (512 tokens, 4 chunks), balanced (1024 tokens, 10 chunks), rich (2048 tokens, 16 chunks)"
        },
        "privateCopilot.localOnly": {
          "type": "boolean",
          "default": true,
          "description": "Block all remote requests"
        },
        "privateCopilot.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs --production",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.1.0",
    "vitest": "^0.34.0",
    "@vscode/vsce": "^2.0.0",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "@private-copilot/core": "workspace:*",
    "@private-copilot/shared": "workspace:*"
  }
}
